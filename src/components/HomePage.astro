---
/**
 * Accueil : le simulateur du mois en tête, les six chiffres de l'année dans un tableau, la réponse en un paragraphe
 * replié, les six questions qui mènent chacune à sa page, le calendrier de la proposition de loi, les pages par
 * rubrique et les explications longues en accordéons. Texte : src/content/home.ts.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import { HOME } from '../content/home';
import { route, hasRoute, type Locale } from '../i18n/routes';
import { GROUPS } from '../i18n/nav';
import { t } from '../i18n/ui';
import { sourceList } from '../lib/helpers';
import { LAST_UPDATED } from '../data/site-config';
import { GUIDES } from '../lib/pages';
import { displayDate } from '../lib/format';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = HOME[lang];
const path = route('home', lang);
const sources = sourceList(HOME.sources, lang);
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(x.faqs, lang)];
const ui = t(lang);
const L = (fr: string, en: string) => (lang === 'fr' ? fr : en);
const fecha = (iso: string) => displayDate(iso, lang === 'fr' ? 'fr-FR' : 'en-GB');
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} sources={sources}>
  <header class="mb-4">
    <h1 class="text-[1.7rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
    <p class="mt-2 text-base text-navy-700 sm:text-lg">{x.intro}</p>
    <div class="mt-1 text-xs font-medium uppercase tracking-wide text-navy-500">{ui.independent}</div>
  </header>
  <div id="simulateur" data-outil data-chrome class="scroll-mt-20"><Tool kind="partage" lang={lang} idPrefix="home" /></div>
  <p class="mt-2 text-sm text-navy-600" data-chrome>{ui.privacyLine}</p>
  <Clamp text={x.resume} lang={lang} id="clamp-home" class="my-8" />
  <aside class="mt-8" aria-labelledby="questions-h" data-chrome>
    <h2 id="questions-h" class="text-2xl font-bold text-navy-900">{x.questionsTitle}</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {x.questions.filter((q) => hasRoute(q.id, lang)).map((q) => (
        <a href={route(q.id, lang)} class="block h-full rounded-lg border-2 border-accent-500 bg-white px-4 py-3 hover:bg-accent-50"><span class="font-semibold text-accent-700">{q.q} →</span><span class="mt-1 block text-sm text-navy-700">{q.a}</span></a>
      ))}
    </div>
  </aside>
  <section class="mt-10">
    <h2 class="text-2xl font-bold text-navy-900">{x.chiffresTitle}</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="journal w-full text-sm">
        <thead><tr><th scope="col" class="px-3 py-2 text-left font-semibold text-navy-900">{L('Règle', 'Rule')}</th><th scope="col" class="px-3 py-2 text-right font-semibold text-navy-900">{L('Valeur', 'Value')}</th></tr></thead>
        <tbody>{x.chiffres.map(([k, v]) => <tr><td class="border-b border-navy-100 px-3 py-2 text-navy-800">{k}</td><td class="tabular-nums border-b border-navy-100 px-3 py-2 text-right font-semibold text-navy-900">{v}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="mt-2 text-sm text-navy-600">{x.chiffresNote}</p>
  </section>
  <section class="mt-10" data-chrome>
    <h2 class="text-2xl font-bold text-navy-900">{x.calendrierTitle}</h2>
    <p class="mt-1 text-sm text-navy-600">{x.calendrierNote}</p>
    <ol class="mt-4 border-l-2 border-navy-200 pl-5">
      {x.calendrier.map((m) => <li class="relative mb-3"><span class="absolute -left-[1.6rem] top-1.5 h-2.5 w-2.5 rounded-full bg-accent-500" aria-hidden="true"></span><time datetime={m.iso} class="tabular-nums text-sm font-semibold text-navy-900">{m.iso <= LAST_UPDATED ? '✓ ' : ''}{fecha(m.iso)}</time><span class="block text-sm text-navy-700">{m.t}</span></li>)}
    </ol>
    <p class="text-sm"><a href={route('reforme', lang)} class="font-medium text-accent-700 underline">{L('Les deux versions du texte, mesure par mesure', 'Both versions of the bill, measure by measure')}</a></p>
  </section>
  <section class="mt-10">
    <h2 class="text-2xl font-bold text-navy-900">{x.foldTitle}</h2>
    <div class="mt-3">
      {x.folds.map((fo) => (
        <details class="fold">
          <summary><h3 class="fold-h">{fo.h}</h3></summary>
          <div class="prose prose-slate max-w-none pb-2" set:html={fo.html} />
        </details>
      ))}
    </div>
  </section>
  <section class="mt-10" data-chrome>
    <h2 class="text-2xl font-bold text-navy-900">{x.guidesTitle}</h2>
    {GROUPS.map((g) => (
      <article class="mt-5">
        <h3 class="text-lg font-semibold text-navy-900">{g.label[lang]}</h3>
        <div class="mt-2 grid gap-2 text-sm md:grid-cols-3">
          {GUIDES.filter((p) => p.group === g.id && hasRoute(p.id, lang)).map((p) => <a href={route(p.id, lang)} class="block h-full rounded-lg border border-navy-200 px-3 py-2 hover:border-accent-300 hover:bg-accent-50"><span class="font-semibold text-accent-700 underline underline-offset-2">{p[lang].nav} →</span><span class="block text-navy-600">{p[lang].card}</span></a>)}
        </div>
      </article>
    ))}
    <p class="mt-6 text-sm text-navy-700"><a href={route('method', lang)} class="font-medium text-accent-700 underline">{L('Comment calculent les simulateurs et d\'où viennent les chiffres', 'How the simulators calculate and where the figures come from')}</a> · <a href={route('about', lang)} class="font-medium text-accent-700 underline">{L('Qui publie ce site', 'Who publishes this site')}</a></p>
  </section>
</PageLayout>
