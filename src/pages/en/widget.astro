---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/${lang}/simulateur-titres-restaurant/" title="French meal voucher simulator 2026" width="100%" height="900" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the French meal voucher simulator for free, 2026" description="Embed the 2026 French meal voucher simulator for free with an iframe: employer share, deduction from pay and exemption. Figures update on their own when rules change." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: lang === 'fr' ? 'Accueil' : 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the simulator</h1>
    <p class="mt-3 text-lg text-navy-700">For works councils, HR departments and associations: copy the code once, and new limits appear on their own.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p set:html={`For the French version, replace <code>/embed/en/</code> with <code>/embed/fr/</code>. Terms: the link under the simulator stays visible, is not changed and is provided without warranty. What your readers type stays on their device. The simulator does not belong to an issuer or a public body.`} />
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/${lang}/simulateur-titres-restaurant/`} title="French meal voucher simulator 2026" width="100%" height="900" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
