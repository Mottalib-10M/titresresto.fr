---
/** Pages à intégrer (iframe) : un outil seul, en français et en anglais. noindex, hors du sitemap (astro.config). */
import '../../../styles/global.css';
import Tool from '../../../components/Tool.astro';
import { SITE_URL, SITE_NAMES, LANG_TAGS } from '../../../data/site-config';
import { route, hasRoute } from '../../../i18n/routes';
import type { Lang } from '../../../lib/format';
const EMBEDS = {
  'simulateur-titres-restaurant': { kind: 'partage', page: 'home', t: { fr: 'Simulateur titres-restaurant 2026', en: 'French meal voucher simulator 2026' } },
} as const;
export function getStaticPaths() {
  return (['fr', 'en'] as const).flatMap((lang) => ['simulateur-titres-restaurant'].map((name) => ({ params: { lang, name } })));
}
const { lang, name } = Astro.params as { lang: Lang; name: keyof typeof EMBEDS };
const e = EMBEDS[name];
const page = `${SITE_URL}${route(hasRoute(e.page, lang) ? e.page : 'home', lang)}`;
const sp = '<a href="https://www.service-public.gouv.fr/particuliers/vosdroits/F21059" rel="nofollow noopener" target="_blank" class="underline">service-public.fr</a>';
const note = { fr: `Site indépendant, ni émetteur ni administration · contient des informations de ${sp} (DILA, Licence Ouverte 2.0) · outil de Radif Partners`, en: `Independent site, not an issuer or a public body · contains information from ${sp} (DILA, Licence Ouverte 2.0) · tool by Radif Partners` }[lang];
---
<!doctype html>
<html lang={LANG_TAGS[lang]}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{`${e.t[lang]} (${lang === 'fr' ? 'à intégrer' : 'embed'})`}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={page} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <main><Tool kind={e.kind} lang={lang} idPrefix="embed" /></main>
    <p class="mt-2 text-center text-xs text-navy-600"><a href={page} target="_blank" rel="noopener" class="underline">{SITE_NAMES[lang]}</a> · <Fragment set:html={note} /></p>
  </body>
</html>
